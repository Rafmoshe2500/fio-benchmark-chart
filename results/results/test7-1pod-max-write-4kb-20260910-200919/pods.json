                        "args": [
                            "set -o pipefail\necho \"pod 0 of 1, run test7-1pod-max-write-4kb-20260910-200919\"\ncp /fio-config/fio.job /tmp/fio.job\nsed -i 's|directory=.*|directory=/mnt/fio-data|g' /tmp/fio.job\nmkdir -p /tmp/fiolog\n\necho \"=== environment ===\"\necho \"node=${NODE_NAME} pod=${POD_NAME}\"\nfio --version\ndf -h /mnt/fio-data\ngrep \"/mnt/fio-data\" /proc/mounts || true\n\necho \"=== fio job ===\"\ncat /tmp/fio.job\n\n# Capacity gate. size is per clone, so the dataset is size x clones.\n# This runs inside the pod on purpose: scripts/deploy_test.sh checks\n# the same thing beforehand, but a bare `helm install` bypasses it,\n# and this is the failure that killed results/test4_*.\nNUMJOBS=$(sed -n 's/^[[:space:]]*numjobs[[:space:]]*=[[:space:]]*\\([0-9]\\+\\).*/\\1/p' /tmp/fio.job | head -1)\nSECTIONS=$(grep -c '^\\[' /tmp/fio.job)\nSECTIONS=$((SECTIONS \u003e 1 ? SECTIONS - 1 : 1))\nif [ -n \"$NUMJOBS\" ]; then CLONES=$((NUMJOBS * SECTIONS)); else CLONES=$SECTIONS; fi\nSIZE_RAW=$(sed -n 's/^[[:space:]]*size[[:space:]]*=[[:space:]]*\\([0-9]\\+[KMGTkmgt]\\?\\).*/\\1/p' /tmp/fio.job | head -1)\nSIZE_NUM=$(echo \"$SIZE_RAW\" | tr -cd '0-9')\ncase \"$(echo \"$SIZE_RAW\" | tr -cd 'KMGTkmgt' | tr '[:lower:]' '[:upper:]')\" in\n  K) MULT=1 ;; M) MULT=1024 ;; G) MULT=$((1024*1024)) ;;\n  T) MULT=$((1024*1024*1024)) ;; *) MULT=1 ;;\nesac\nNEED_KB=$((SIZE_NUM * MULT * CLONES))\nAVAIL_KB=$(df -Pk /mnt/fio-data | awk 'NR==2 {print $4}')\necho \"=== capacity ===\"\necho \"dataset: size=${SIZE_RAW} x ${CLONES} clones = $((NEED_KB/1024/1024)) GiB\"\necho \"mount:   $((AVAIL_KB/1024/1024)) GiB free\"\nif [ \"$NEED_KB\" -gt \"$AVAIL_KB\" ]; then\n  echo \"FATAL: PVC is too small for this job.\"\n  echo \"  fio would lay out files until ENOSPC, kill part of the workload,\"\n  echo \"  and still exit having produced a plausible-looking log.\"\n  echo \"  Set pvc.size to at least $(( (NEED_KB * 12 / 10) / 1024 / 1024 ))Gi and re-run.\"\n  exit 28\nfi\n\n# cgroup CPU pressure, before. If the client is throttled during the\n# run then its tail latency describes the CFS scheduler, not NFS.\nCG=\"\"\nif [ -r /sys/fs/cgroup/cpu.stat ]; then CG=/sys/fs/cgroup/cpu.stat\nelif [ -r /sys/fs/cgroup/cpu/cpu.stat ]; then CG=/sys/fs/cgroup/cpu/cpu.stat\nfi\nCG_BEFORE=$([ -n \"$CG\" ] \u0026\u0026 tr '\\n' ' ' \u003c \"$CG\" || echo \"\")\n# Absolute-time barrier. Every pod in every release of this run waits\n# for the same instant, so a burst phase actually overlaps the phase\n# it is meant to burst against, rather than starting whenever helm\n# happened to return.\nTARGET=1789085539\nNOW=$(date +%s)\nif [ \"$NOW\" -lt \"$TARGET\" ]; then\n  echo \"barrier: waiting $((TARGET - NOW))s until $(date -d @$TARGET)\"\n  while [ \"$(date +%s)\" -lt \"$TARGET\" ]; do sleep 0.2; done\nelse\n  echo \"barrier: WARNING started $((NOW - TARGET))s late; overlap is not guaranteed\"\nfi\n\necho \"=== fio start $(date -u +%Y-%m-%dT%H:%M:%SZ) epoch=$(date +%s) ===\"\nfio /tmp/fio.job --output-format=json+ --output=/tmp/fio.json\nFIO_RC=$?\necho \"=== fio end $(date -u +%Y-%m-%dT%H:%M:%SZ) epoch=$(date +%s) rc=$FIO_RC ===\"\n\necho \"===FIO_CGROUP_BEGIN===\"\necho \"before: ${CG_BEFORE}\"\necho \"after: $([ -n \"$CG\" ] \u0026\u0026 tr '\\n' ' ' \u003c \"$CG\" || echo \"\")\"\necho \"===FIO_CGROUP_END===\"\n# Markers let collect_results.sh extract the JSON from kubectl logs\n# without needing a shared volume or a sidecar.\necho \"===FIO_JSON_BEGIN===\"\ncat /tmp/fio.json\necho \"===FIO_JSON_END===\"\necho \"===FIO_TSLOG_BEGIN===\"\nfor l in /tmp/fiolog/*.log; do\n  [ -f \"$l\" ] || continue\n  echo \"--- $(basename \"$l\") ---\"\n  cat \"$l\"\ndone\necho \"===FIO_TSLOG_END===\"\n\n# Propagate the real result. Without this the container exits 0 on a\n# failed fio and kubectl reports Completed for a run that died.\nexit $FIO_RC\n"
