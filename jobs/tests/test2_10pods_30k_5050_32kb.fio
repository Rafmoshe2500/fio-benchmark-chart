[global]
ioengine=libaio
direct=1
fallocate=none
size=10G
runtime=600
time_based=1
group_reporting=1
directory=/mnt/fio-data

iodepth=32
iodepth_batch_submit=32
iodepth_batch_complete_min=1
iodepth_batch_complete_max=32

# --- standardised policy: identical across every test so the results are
# --- comparable to each other. See docs/superpowers/plans/ Task 4.
ramp_time=60
randrepeat=0
norandommap=1
refill_buffers=1
scramble_buffers=1
randseed=20260909

# Time series. Without these there is no distinguishing a steady 10K IOPS
# from 20K for five minutes and zero for five more.
write_iops_log=/tmp/fiolog/fio
write_bw_log=/tmp/fiolog/fio
write_lat_log=/tmp/fiolog/fio
log_avg_msec=1000
per_job_logs=1

[test2-30k-32k-write-1]
rw=randwrite
bs=32k
rate_iops=3750

[test2-30k-32k-read-1]
rw=randread
bs=32k
rate_iops=3750

[test2-30k-32k-write-2]
rw=randwrite
bs=32k
rate_iops=3750

[test2-30k-32k-read-2]
rw=randread
bs=32k
rate_iops=3750

[test2-30k-32k-write-3]
rw=randwrite
bs=32k
rate_iops=3750

[test2-30k-32k-read-3]
rw=randread
bs=32k
rate_iops=3750

[test2-30k-32k-write-4]
rw=randwrite
bs=32k
rate_iops=3750

[test2-30k-32k-read-4]
rw=randread
bs=32k
rate_iops=3750
