[global]
ioengine=libaio
direct=1
size=10G
runtime=600
time_based=1
group_reporting=1
directory=/mnt/fio-data
numjobs=8
iodepth=32

# --- standardised policy: identical across every test so the results are
# --- comparable to each other. See docs/superpowers/plans/ Task 4.
ramp_time=60
randrepeat=0
norandommap=1
refill_buffers=1
scramble_buffers=1
randseed=20260909

# Time series. Without these there is no distinguishing a steady 10K IOPS
# from 20K for five minutes and zero for five more.
write_iops_log=/tmp/fiolog/fio
write_bw_log=/tmp/fiolog/fio
write_lat_log=/tmp/fiolog/fio
log_avg_msec=1000
per_job_logs=1

[test3-50k-5050-4k]
rw=randrw
rwmixread=50
bs=4k
# 50,000 IOPS per pod / 8 clones = 6250 per clone, split 50/50.
# rate_iops=625 gave 1250/clone = 10K/pod -- one fifth of the target.
rate_iops=3125,3125
