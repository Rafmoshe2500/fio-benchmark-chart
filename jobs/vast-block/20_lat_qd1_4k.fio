# Lowest achievable latency: one job, QD1. Run on a single pod (replicaCount=1) with no other load.
[global]
ioengine=libaio
direct=1
filename=/dev/fio-block
size=50G
runtime=120
ramp_time=15
time_based=1
group_reporting=1
numjobs=1
iodepth=1

refill_buffers=1
scramble_buffers=1
randrepeat=0
norandommap=1

lat_percentiles=1
percentile_list=50:90:99:99.9:99.99

[lat-read-4k-qd1]
rw=randread
bs=4k

[lat-write-4k-qd1]
stonewall
rw=randwrite
bs=4k
